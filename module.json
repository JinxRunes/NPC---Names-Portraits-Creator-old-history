{
  "id": "npc-name-portrait-creator",
  "title": "NPC Name & Portrait Creator",
  "description": "Mass-produce actor duplicates from a template using a local image folder or an existing Foundry/CDN directory path.",
  "version": "1.2.2",
  "compatibility": {
    "minimum": "14",
    "verified": "14.366"
  },
  "authors": [
    {
      "name": "Jinx"
    }
  ],
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/npc-creator.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": [".css", ".mjs", ".json", ".hbs"],
      "paths": ["scripts", "styles", "languages", "templates"]
    }
  }
}
